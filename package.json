{
  "name": "convex-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "local:up": "docker compose -f local/docker-compose.yml up -d && sh local/ensure-key.sh && echo 'Next: pnpm local:push (push backend code), pnpm local:web (frontend). Dashboard: http://localhost:6791'",
    "local:down": "docker compose -f local/docker-compose.yml down",
    "local:reset": "docker compose -f local/docker-compose.yml down -v && rm -f local/.admin-key local/.env",
    "local:push": "sh local/with-env.sh ./node_modules/.bin/convex dev --once --env-file local/.env",
    "local:dev": "sh local/with-env.sh ./node_modules/.bin/convex dev --env-file local/.env",
    "local:web": "sh local/web.sh",
    "local:run": "sh local/with-env.sh ./node_modules/.bin/convex run",
    "local:data": "sh local/with-env.sh ./node_modules/.bin/convex data",
    "local:logs": "docker compose -f local/docker-compose.yml logs -f backend"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^9.39.2",
    "@lucide/svelte": "^1.8.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/lodash": "^4.17.25",
    "@typescript/native": "npm:typescript@^7.0.2",
    "convex": "^1.27.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.51.0",
    "svelte-check": "^4.7.5",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@tanstack/svelte-query": "^6.1.0",
    "animejs": "^4.5.0",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "convex-svelte": "^0.0.9",
    "lodash": "^4.17.23",
    "phaser": "^4.2.1",
    "temporal-polyfill": "^1.0.4"
  }
}
